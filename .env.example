# ─── EnergyPlus ───────────────────────────────────────────────────────────
# Path to the EnergyPlus installation directory (where energyplus binary lives)
ENERGYPLUS_DIR=/usr/local/EnergyPlus-24-2-0

# ─── Ollama ───────────────────────────────────────────────────────────────
# Ollama server URL (default: local)
OLLAMA_HOST=http://localhost:11434

# LLM model for the AI agent
OLLAMA_MODEL=qwen2.5:7b-instruct

# ─── Simulation ───────────────────────────────────────────────────────────
# IDF model file (relative to project root)
IDF_PATH=simulation/models/baseline_office.idf

# Weather file (relative to project root)
EPW_PATH=simulation/weather/chicago.epw

# ─── Telemetry ────────────────────────────────────────────────────────────
# SQLite database path (relative to project root)
TELEMETRY_DB=telemetry.db

# ─── Dashboard ────────────────────────────────────────────────────────────
# Streamlit dashboard port
DASHBOARD_PORT=8501
